rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Sessão anônima = modo admin (entrou pela senha única da equipe).
    // Sessão com e-mail/senha = aluno logado com CPF/senha próprios.
    function isAdmin() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // Cadastros antigos (feitos pela equipe, sem login vinculado ainda)
    // não têm o campo uid — é assim que um aluno "assume" seu cadastro
    // já existente na primeira vez que cria a conta.
    function isUnclaimed() {
      return !("uid" in resource.data) || resource.data.uid == null || resource.data.uid == "";
    }

    // Lista de unidades é pública para leitura — precisa aparecer no
    // formulário de cadastro do aluno, antes de ele ter login. Só a
    // equipe pode criar/editar/remover unidades.
    // Índice CPF -> e-mail interno da conta. Leitura pública porque é
    // consultado ANTES do login (pra achar com qual e-mail tentar entrar,
    // ou pra onde mandar o link de "esqueci minha senha"). Não expõe nada
    // sensível — só o e-mail sintético/recuperação de cada CPF.
    match /cpfIndex/{cpfId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /units/{unitId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Um aluno só pode criar/editar o PRÓPRIO cadastro (ou assumir um
    // cadastro antigo feito pela equipe, na primeira vez que loga). A
    // equipe (admin) continua podendo gerenciar qualquer cadastro.
    match /students/{studentId} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || isSelf(request.resource.data.uid);
      allow update: if isAdmin() || isSelf(resource.data.uid) || (isUnclaimed() && isSelf(request.resource.data.uid));
      allow delete: if isAdmin();
    }

    // Aulas e presenças: qualquer pessoa logada (admin ou aluno) pode
    // criar ao marcar presença. Editar ou apagar fica só com a equipe.
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Apagar aqui é "desmarcar" alguém que foi checado por engano —
      // tanto admin quanto professor precisam poder fazer isso na própria turma.
      allow delete: if request.auth != null;
      allow update: if isAdmin();
    }
  }
}
