rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Qualquer usuário autenticado (mesmo anônimo, que é como o app entra
    // por baixo dos panos) pode ler e escrever. A proteção real de acesso
    // é a senha única na tela de login do app — isso aqui só impede que
    // alguém de fora, sem passar pelo app, acesse o banco diretamente.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
